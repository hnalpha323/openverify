{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "@openverify/config#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/apps/*/vitest.config.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/vitest.config.ts",
        "$TURBO_ROOT$/pnpm-workspace.yaml"
      ],
      "outputs": ["coverage/**"]
    },
    "@openverify/docs-tools#test": {
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@openverify/e2e#e2e": {
      "dependsOn": ["^build", "@openverify/flow#e2e"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
