{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openverify:fixtures:consent-texts:1",
  "title": "The released built-in consent texts, append-only (C161.8, C162.9, C200.3)",
  "description": "The table the server's digest check reads. Web rows are written by apps/flow/scripts/export-flow-locales.ts; Android rows (client android, catalog version android-<sdk version>-<16 hex>) by :openverify-sdk:exportConsentTexts (api-android-10a), placeholders in the {{name}} form. An entry is never changed or removed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "description", "entries"],
  "properties": {
    "format": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalog-version", "client", "key", "locale", "text"],
        "properties": {
          "catalog-version": {
            "type": "string",
            "pattern": "^(web-[0-9a-f]{16}|android-[0-9]+\\.[0-9]+\\.[0-9]+-[0-9a-f]{16})$"
          },
          "client": {
            "enum": ["web", "android"]
          },
          "key": {
            "type": "string"
          },
          "locale": {
            "enum": ["en", "es", "fr", "de", "ar"]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
