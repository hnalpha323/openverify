  },
  "version": {
    "flow": {
      "metadata": {
        "specVersion": 2,
        "id": "e2e-android-10a",
        "version": 1,
        "name": "Android renderer"
      },
      "entry": "consent",
      "steps": [
        {
          "id": "consent",
          "type": "consent",
          "textKeys": [
            "consent.biometric",
            "consent.processing",
            "notice.session-integrity",
            "notice.play-integrity"
          ],
          "required": true
        },
        {
          "id": "records",
          "type": "database",
          "fields": [
            "name_first",
            "name_last",
            "birthdate",
            "address_street_1",
            "address_city",
            "address_postal_code",
            "address_country_code"
          ]
        },
        {
          "id": "hello",
          "type": "screen",
          "components": [
            {
              "id": "heading",
              "kind": "text",
              "variant": "title",
              "copyKey": "hello.heading.title"
            },
            {
              "id": "go",
              "kind": "button",
              "labelKey": "screen.continue",
              "action": "submit"
            }
          ]
        },
        {
          "id": "by_language",
          "type": "branch",
          "routes": [
            {
              "key": "spanish",
              "label": "Spanish",
              "condition": {
                "===": [
                  {
                    "var": "session.locale"
                  },
                  "es"
                ]
              },
              "onNull": "else"
            }
          ]
        },
        {
          "id": "hola",
          "type": "screen",
          "components": [
            {
              "id": "heading",
              "kind": "text",
              "variant": "title",
              "copyKey": "hola.heading.title"
            },
            {
              "id": "go",
              "kind": "button",
              "labelKey": "screen.continue",
              "action": "submit"
            }
          ]
        },
        {
          "id": "done",
          "type": "completion"
        }
      ],
      "edges": [
        {
          "id": "e1",
          "from": "consent",
          "port": "next",
          "to": "records"
        },
        {
          "id": "e2",
          "from": "records",
          "port": "next",
          "to": "hello"
        },
        {
          "id": "e3",
          "from": "hello",
          "port": "next",
          "to": "by_language"
        },
        {
          "id": "e4",
          "from": "by_language",
          "port": "route:spanish",
          "to": "hola"
        },
        {
          "id": "e5",
          "from": "by_language",
          "port": "else",
          "to": "done"
        },
        {
          "id": "e6",
          "from": "hola",
          "port": "next",
          "to": "done"
        }
      ]
    },
    "verification-config": {
      "database": {
        "checks": {
          "database_identity_comparison": {
            "enabled": true,
            "required": true
          },
          "database_name_comparison": {
            "enabled": true,
            "required": false
          },
          "database_address_comparison": {
            "enabled": true,
            "required": false
          },
          "database_birthdate_comparison": {
            "enabled": true,
            "required": false
          },
          "database_inquiry_comparison": {
            "enabled": true,
            "required": false
          },
          "database_po_box_detection": {
            "enabled": true,
            "required": false
          }
        }
      }
    },
    "signal-config": {
      "collect": "default"
    },
    "copy": {
      "messages": {
        "en": {
          "hello.heading.title": "Almost done",
          "hola.heading.title": "One more screen"
        },
        "es": {
          "hello.heading.title": "Casi listo",
          "hola.heading.title": "Una pantalla más"
        }
      }
    },
    "enabled-locales": ["en", "es"],
    "default-locale": "en"
  }
