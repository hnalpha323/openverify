{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openverify:android:review-status:1",
  "title": "Android SDK locale review status (C199.1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "description",
    "locales",
    "keys"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es",
        "fr",
        "de",
        "ar"
      ],
      "properties": {
        "en": {
          "$ref": "#/$defs/status"
        },
        "es": {
          "$ref": "#/$defs/status"
        },
        "fr": {
          "$ref": "#/$defs/status"
        },
        "de": {
          "$ref": "#/$defs/status"
        },
        "ar": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "keys": {
      "type": "object",
      "propertyNames": {
        "pattern": "^openverify_[a-z0-9_]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^strings(_[a-z0-9_]+)?\\.xml$"
          }
        }
      }
    }
  },
  "$defs": {
    "status": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "source"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "machine-drafted"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "unreviewedKeys"
          ],
          "properties": {
            "status": {
              "const": "partially-reviewed"
            },
            "unreviewedKeys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "by": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "catalogSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "keySha256": {
              "$ref": "#/$defs/digests"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "by",
            "date",
            "catalogSha256",
            "keySha256"
          ],
          "properties": {
            "status": {
              "const": "reviewed"
            },
            "by": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "catalogSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "keySha256": {
              "$ref": "#/$defs/digests"
            }
          }
        }
      ]
    },
    "digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
