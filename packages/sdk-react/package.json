{
  "name": "@openverify/react",
  "version": "0.0.0",
  "private": true,
  "description": "React bindings for the OpenVerify embed client (plan C266.2): an <OpenVerifyFlow> component and a useOpenVerify hook over @openverify/js; the server decides every step",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@openverify/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hnalpha323/openverify.git",
    "directory": "packages/sdk-react"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@openverify/js": "workspace:*"
  },
  "devDependencies": {
    "@openverify/config": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
