          "messageKey": "flow.completion"
        },
        {
          "id": "failure",
          "type": "failure",
          "messageKey": "flow.failure"
        }
      ],
      "transitions": [
        {
          "from": "government_id",
          "to": "failure",
          "condition": {
            "==": [
              {
                "var": "inquiry.status"
              },
              "failed"
            ]
          }
        },
        {
          "from": "selfie",
          "to": "failure",
