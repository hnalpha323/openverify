#!/bin/sh
# OpenVerify pre-commit hook: block commits whose STAGED changes contain secrets.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Install gitleaks:        infra/scripts/install-gitleaks.sh   (pinned version, SHA-256 verified)
# Test:                    infra/tests/pre-commit-hook.test.sh
#
# Fails closed: when gitleaks is missing or errors out, the commit is blocked. The repo-root
# .gitleaks.toml and .gitleaksignore are picked up automatically when present. Findings are
# printed with the secret redacted. CI re-scans the full history (job "secrets"), so this hook
# is a fast local guard, not the only one.
#
# Second scan (C260.3, Workflow 11C): the PII-pattern configuration security/gitleaks-pii.toml,
# with its reviewed allowlist, on the staged changes, through security/gitleaks-pii-filter.py
# (python3 -I, standard library), which keeps the checksum-valid card and IBAN matches and prints
# rule, file and line, never the value. It fails closed like the first: without the
# configuration, the filter or python3, or on any finding, the commit is blocked.
set -u

gitleaks_bin=$(command -v gitleaks 2>/dev/null || true)
if [ -z "$gitleaks_bin" ] && [ -x "${HOME:-}/.local/bin/gitleaks" ]; then
  gitleaks_bin="$HOME/.local/bin/gitleaks"
fi
if [ -z "$gitleaks_bin" ]; then
  echo "pre-commit: gitleaks not found; commit blocked (secret scanning is mandatory)." >&2
  echo "pre-commit: install it with infra/scripts/install-gitleaks.sh, then retry." >&2
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel) || exit 1

# gitleaks >= 8.19 scans staged changes with `git --pre-commit --staged`; older releases only
# have the (now deprecated) `protect --staged`.
if "$gitleaks_bin" git --help >/dev/null 2>&1; then
  set -- git --pre-commit --staged "$repo_root"
else
  set -- protect --staged --source "$repo_root"
fi

if ! "$gitleaks_bin" "$@" --redact --verbose --no-banner --no-color; then
  echo "pre-commit: gitleaks reported potential secrets (or failed) on the staged changes; commit blocked." >&2
  echo "pre-commit: remove the secret, or for a verified false positive add its fingerprint to .gitleaksignore." >&2
  exit 1
fi

pii_config="$repo_root/security/gitleaks-pii.toml"
pii_filter="$repo_root/security/gitleaks-pii-filter.py"
python_bin=$(command -v python3 2>/dev/null || true)
if [ ! -f "$pii_config" ] || [ ! -f "$pii_filter" ] || [ -z "$python_bin" ]; then
  echo "pre-commit: the PII-pattern scan needs security/gitleaks-pii.toml, security/gitleaks-pii-filter.py and python3; commit blocked." >&2
  exit 1
fi
# gitleaks resolves the configuration's [extend] path from the working directory.
if ! (cd "$repo_root" && "$python_bin" -I security/gitleaks-pii-filter.py --gitleaks "$gitleaks_bin" git --pre-commit --staged .); then
  echo "pre-commit: the PII-pattern scan found what looks like personal data (or failed) in the staged changes; commit blocked." >&2
  echo "pre-commit: use synthetic values (example.com or .test addresses, 192.0.2.0/24, 555-01xx numbers, the generators' names); a reviewed exception goes in security/gitleaks-pii-allowlist.toml with its reason." >&2
  exit 1
fi
