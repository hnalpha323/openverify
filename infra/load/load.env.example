# The load stack's env file template (Workflow 11D, C268.4; Stage 1a amendment 9). Never copied by
# hand: infra/load/make-load-env.sh writes /tmp/openverify-load/load.env (mode 0600) from it, each
# change-me value replaced by a fresh random one (change-me-base64-32: base64 of 32 random bytes;
# any other change-me: 24 random bytes as hex). The env file is never committed, printed or logged.
# Compose reads it for interpolation (--env-file); seed:load, the sampler and the take runner read
# it on the host (set -a; . /tmp/openverify-load/load.env; set +a).
#
# Ports: loopback only, below the ephemeral range the e2e stack draws from, distinct from the
# developer's stack (compose merges an override's ports with the base's, so they are set here).
OPENVERIFY_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=25432
REDIS_PORT=26379
S3_PORT=29000
S3_CONSOLE_PORT=29001
MAILPIT_SMTP_PORT=21025
MAILPIT_UI_PORT=28025
OPENVERIFY_API_PORT=23000
OPENVERIFY_FLOW_PORT=25173
OPENVERIFY_DASHBOARD_PORT=23001
# The load network: its gateway is the socket peer of a host generator, the API's trusted proxy.
OPENVERIFY_LOAD_SUBNET=172.30.240.0/24
OPENVERIFY_LOAD_GATEWAY=172.30.240.1
# The database and its two roles (the migration role is POSTGRES_USER, the owner).
POSTGRES_USER=openverify
POSTGRES_DB=openverify_load
POSTGRES_PASSWORD=change-me-postgres
OPENVERIFY_LOAD_RUNTIME_PASSWORD=change-me-runtime
REDIS_PASSWORD=change-me-redis
S3_BUCKET=openverify-files
S3_ACCESS_KEY_ID=change-me-s3-access
S3_SECRET_ACCESS_KEY=change-me-s3-secret
OPENVERIFY_KEK=change-me-base64-32
OPENVERIFY_API_KEY_PEPPER=change-me-pepper
OPENVERIFY_BLIND_INDEX_KEY=change-me-base64-32
OPENVERIFY_VISION_SERVICE_TOKEN=change-me-vision-token
OPENVERIFY_FLOW_SERVER_TOKEN=change-me-flow-server-token
OPENVERIFY_DASHBOARD_BFF_TOKEN=change-me-dashboard-bff-token
OPENVERIFY_MODE=development
OPENVERIFY_CONNECT_ENABLED=true
OPENVERIFY_DASHBOARD_INSECURE_COOKIES=true
OPENVERIFY_FLOW_API_URL=http://127.0.0.1:23000
OPENVERIFY_DASHBOARD_PUBLIC_URL=http://127.0.0.1:23001
OPENVERIFY_FLOW_PUBLIC_URL=http://127.0.0.1:25173
# The fairness scenario's labelled configuration "ceiling 200" sets this to 200; 50 otherwise.
OPENVERIFY_QUEUE_IN_FLIGHT_CAP_MAX=50
