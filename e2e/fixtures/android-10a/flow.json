{
  "description": "C224.3, C224.4 (Workflow 10A): the 10A flow (consent, a sandbox database step, a screen, a branch on session.locale, a Spanish screen, a completion), driven by e2e/tests/flow-android.spec.ts and :openverify-sdk:stackTest. Written by e2e/src/android-flow.test.ts under UPDATE_CONTRACT_FIXTURES=1; synthetic.",
  "template": {
    "flow": {
      "metadata": {
        "specVersion": 1,
        "id": "default-gov-id-selfie",
        "version": 3,
        "name": "Government ID and selfie",
        "description": "Consent, a two-sided government ID, then a selfie compared with the ID portrait."
      },
      "steps": [
        {
          "id": "consent",
          "type": "consent",
          "textKeys": ["consent.biometric", "consent.processing", "notice.session-integrity"],
          "optionalTextKeys": ["consent.biometric-matching"],
          "required": true
        },
        {
          "id": "government_id",
          "type": "government_id",
          "sides": "both",
          "maxAttempts": 3,
          "captureMethods": ["upload", "camera"]
        },
        {
          "id": "selfie",
          "type": "selfie",
          "poses": ["center", "left", "right"],
          "liveness": "active",
          "maxAttempts": 3
        },
        {
          "id": "completion",
          "type": "completion",
          "messageKey": "flow.completion"
        },
        {
          "id": "failure",
          "type": "failure",
          "messageKey": "flow.failure"
        }
      ],
      "transitions": [
        {
          "from": "government_id",
          "to": "failure",
          "condition": {
            "==": [
              {
                "var": "inquiry.status"
              },
              "failed"
            ]
          }
        },
        {
          "from": "selfie",
          "to": "failure",
          "condition": {
            "==": [
              {
                "var": "inquiry.status"
              },
              "failed"
            ]
          }
        }
      ]
    },
    "verification-config": {
      "government-id": {
        "checks": {
          "id_unprocessable_submission_detection": {
