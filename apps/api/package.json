{
  "name": "@openverify/api",
  "version": "0.0.0",
  "private": true,
  "description": "REST API, background workers and webhook dispatcher",
  "type": "module",
  "imports": {
    "#src/*": {
      "@openverify/source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.commands.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "dev:worker": "tsx watch --conditions=@openverify/source src/worker.ts",
    "dev:server": "tsx watch --conditions=@openverify/source --env-file-if-exists=../../.env src/server.ts",
    "db:migrate": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/db-migrate.ts",
    "seed:dev": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/seed-dev.ts",
    "kek:rewrap": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/kek-rewrap.ts",
    "blind-index:rebuild": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/blind-index-rebuild.ts",
    "face-index:rebuild": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/face-index-rebuild.ts",
    "face-scan:benchmark": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/face-scan-benchmark.ts",
    "user:reset-mfa": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/user-reset-mfa.ts",
    "retention:run": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/retention-run.ts",
    "trust-anchors:sync": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/trust-anchors-sync.ts",
    "trust:sandbox-utopia": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/trust-sandbox-utopia.ts",
    "org:create": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/org-create.ts",
    "db:grant-runtime": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/db-grant-runtime.ts",
    "api-keys:pepper-status": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/api-keys-pepper-status.ts",
    "user:allow-password": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/user-allow-password.ts",
    "watchlists:sync": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/watchlists-sync.ts",
    "watchlists:rekey": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/watchlists-rekey.ts",
    "watchlists:rebuild-key-df": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/watchlists-rebuild-key-df.ts",
    "pep:sync": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/pep-sync.ts",
    "network:sync": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/network-sync.ts",
    "graph:reindex": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/graph-reindex.ts",
    "graph:benchmark": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/graph-benchmark.ts",
    "analytics:benchmark": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/analytics-benchmark.ts",
    "seed:load": "tsx --conditions=@openverify/source --env-file-if-exists=../../.env scripts/seed-load.ts",
    "openapi:write": "OPENVERIFY_OPENAPI_WRITE=1 vitest run src/openapi.test.ts --coverage.enabled=false",
    "workflow-docs:write": "tsx --conditions=@openverify/source scripts/workflow-docs.ts"
  },
  "devDependencies": {
    "@openverify/config": "workspace:*",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "prettier": "catalog:",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.3",
    "@fastify/swagger": "9.9.2",
    "@node-rs/argon2": "2.2.2",
    "@openverify/checks": "workspace:*",
    "@openverify/contracts": "workspace:*",
    "@openverify/core": "workspace:*",
    "@openverify/db": "workspace:*",
    "@openverify/emrtd": "workspace:*",
    "@openverify/flow-spec": "workspace:*",
    "@openverify/node": "workspace:*",
    "@openverify/signals": "workspace:*",
    "@openverify/watchlist": "workspace:*",
    "@openverify/workflow-engine": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "ajv": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "5.11.1",
    "jose": "catalog:",
    "nodemailer": "10.1.6",
    "oauth4webapi": "catalog:",
    "openid-client": "catalog:",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "temporal-polyfill": "catalog:",
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
