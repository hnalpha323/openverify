          {
            "id": "birthdate",
            "field": "birthdate",
            "labelKey": "form.birthdate",
            "required": true,
            "kind": "date",
            "min": "1900-01-01",
            "max": "2010-12-31"
          },
          {
            "id": "email",
            "field": "email",
            "labelKey": "form.email",
