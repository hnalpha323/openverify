<!--
  The document step (C60, C64.2); values-es holds its Spanish. A picked file is named by its own
  file name and size, shown on the device only; no text shows its contents. Compose Multiplatform
  resources: positional placeholders only, ' and " written as they are (ResourcesTest).
-->
<resources>
    <string name="openverify_document_title">Upload a document</string>
    <string name="openverify_document_intro">Upload a document that shows your full name and your address.</string>
    <string name="openverify_document_accepted">You can upload one of these:</string>
    <!-- C52.2: the window is the guidance's max-age-days; a lease and a tax document follow their own rules (C60.6). -->
    <plurals name="openverify_document_type_utility_bill">
        <item quantity="one">A utility bill dated within the last %1$d day</item>
        <item quantity="other">A utility bill dated within the last %1$d days</item>
    </plurals>
    <plurals name="openverify_document_type_bank_statement">
        <item quantity="one">A bank statement dated within the last %1$d day</item>
        <item quantity="other">A bank statement dated within the last %1$d days</item>
    </plurals>
    <plurals name="openverify_document_type_pay_stub">
        <item quantity="one">A pay stub dated within the last %1$d day</item>
        <item quantity="other">A pay stub dated within the last %1$d days</item>
    </plurals>
    <string name="openverify_document_type_lease">A lease or rental agreement that is still in force</string>
    <string name="openverify_document_type_tax_document">A tax document from the latest tax year</string>
