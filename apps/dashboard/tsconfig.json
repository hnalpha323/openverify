{
  "extends": "../../packages/config/tsconfig.bundler.json",
  "compilerOptions": {
    "types": ["node"],
    // server.ts runs under Node's type stripping, which needs the .ts extension on imports.
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src",
    "server.ts",
    "server.test.ts",
    "next.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ]
}
