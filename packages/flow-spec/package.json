{
  "name": "@openverify/flow-spec",
  "version": "0.0.0",
  "private": true,
  "description": "JSON Schema for server-driven flow definitions, shared by the web flow and Android",
  "type": "module",
  "exports": {
    ".": {
      "@openverify/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "schema:export": "tsx --conditions=@openverify/source scripts/export-json-schema.ts && prettier --write schema/flow.schema.json"
  },
  "devDependencies": {
    "@openverify/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@openverify/core": "workspace:*",
    "zod": "^4.6.7"
  }
}
