{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openverify:fixtures:flow-requests-android:1",
  "title": "Android request fixtures and their zod schemas (C224.4)",
  "description": "Each request body the SDK's real FlowApiClient encodes, asserted through Ktor's MockEngine by the client owner (UPDATE_CONTRACT_FIXTURES=1 writes it) and parsed with its route's zod request schema by apps/api/src/routes/flow/flow-requests.android.test.ts (api-android-10a).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "description",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "method",
          "route",
          "schema",
          "workflow"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.(json|multipart\\.json)$"
          },
          "method": {
            "enum": [
              "GET",
              "POST"
            ]
          },
          "route": {
            "type": "string",
            "pattern": "^/api/v1/flow/"
          },
          "schema": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*Schema$",
            "description": "The export of @openverify/contracts that parses the body."
          },
          "workflow": {
            "enum": [
              "10A",
              "10B",
              "10C"
            ]
          },
          "owner": {
            "type": "string"
          }
        }
      }
    }
  }
}
