{
  "name": "@openverify/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Locked API contracts (browser-safe): IDs, zod schemas for resources, request bodies, documents and events, and the shared vocabulary",
  "type": "module",
  "exports": {
    ".": {
      "@openverify/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./origin-pattern": {
      "@openverify/source": "./src/origin-pattern.ts",
      "types": "./dist/origin-pattern.d.ts",
      "default": "./dist/origin-pattern.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@openverify/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@openverify/core": "workspace:*",
    "@openverify/flow-spec": "workspace:*",
    "zod": "^4.6.7"
  }
}
