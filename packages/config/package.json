{
  "name": "@openverify/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tooling presets for OpenVerify packages (Vitest coverage gate, TypeScript presets)",
  "type": "module",
  "exports": {
    "./vitest": "./src/vitest.ts",
    "./axe": "./src/axe.ts",
    "./eslint-phase5": {
      "types": "./eslint/phase5-rules.d.ts",
      "default": "./eslint/phase5-rules.js"
    },
    "./eslint-logical-properties": {
      "types": "./eslint/logical-properties.d.ts",
      "default": "./eslint/logical-properties.js"
    },
    "./tsconfig.bundler.json": "./tsconfig.bundler.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
