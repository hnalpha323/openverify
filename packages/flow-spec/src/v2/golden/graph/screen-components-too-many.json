                "size": "s"
              },
              {
                "id": "t30",
                "kind": "spacer",
                "size": "s"
              },
              {
                "id": "t31",
                "kind": "spacer",
                "size": "s"
              },
              {
                "id": "t32",
                "kind": "spacer",
                "size": "s"
              },
              {
                "id": "t33",
                "kind": "spacer",
                "size": "s"
              },
              {
                "id": "t34",
                "kind": "spacer",
                "size": "s"
              },
              {
                "id": "t35",
                "kind": "spacer",
                "size": "s"
              },
              {
                "id": "t36",
                "kind": "spacer",
                "size": "s"
              },
              {
                "id": "t37",
                "kind": "spacer",
                "size": "s"
              }
            ]
          }
        ]
      },
      {
        "id": "face",
        "type": "selfie",
        "poses": ["center"],
        "liveness": "passive",
        "maxAttempts": 2
      },
      {
        "id": "tag",
        "type": "action",
        "action": {
          "kind": "tag_inquiry",
          "add": ["checked"]
        }
      },
      {
        "id": "done",
        "type": "completion"
      },
      {
        "id": "rejected",
        "type": "failure"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": "consent",
        "port": "next",
        "to": "details"
      },
      {
        "id": "e2",
        "from": "details",
        "port": "next",
        "to": "id_card"
      },
      {
        "id": "e3",
        "from": "details",
        "port": "button:skip",
        "to": "id_card"
      },
      {
        "id": "e4",
        "from": "id_card",
        "port": "next",
        "to": "age_route"
      },
      {
        "id": "e5",
        "from": "id_card",
        "port": "exhausted",
        "to": "proof"
      },
      {
        "id": "e6",
        "from": "proof",
        "port": "next",
        "to": "age_route"
      },
      {
        "id": "e7",
        "from": "age_route",
        "port": "route:minor",
        "to": "guardian"
      },
      {
        "id": "e8",
        "from": "age_route",
        "port": "else",
        "to": "face"
      },
      {
        "id": "e9",
        "from": "guardian",
        "port": "next",
        "to": "face"
      },
      {
        "id": "e10",
        "from": "face",
        "port": "next",
        "to": "tag"
      },
      {
        "id": "e11",
        "from": "tag",
        "port": "next",
        "to": "done"
      },
      {
        "id": "e12",
        "from": "tag",
        "port": "error",
        "to": "rejected"
      }
    ]
  },
  "added": [["error", "screen_components_too_many", "/steps/5"]]
}
