# OpenVerify local development settings.
#
# Copy to `.env` (git-ignored) and replace every `change-me-*` value. The values below are
# placeholders, never real credentials. Used by:
#   docker compose -f infra/docker-compose.yml --env-file .env up -d --wait          # infrastructure
#   docker compose -f infra/docker-compose.yml --env-file .env --profile app up -d --wait  # + apps
#   pnpm --filter @openverify/api dev:server | dev:worker | db:migrate | seed:dev   # apps on the host

# Host interface the dev services bind to. Keep loopback unless you really need LAN access.
OPENVERIFY_BIND_ADDRESS=127.0.0.1

# --- Postgres 17 + pgvector -------------------------------------------------
POSTGRES_PORT=5432
POSTGRES_USER=openverify
POSTGRES_DB=openverify
POSTGRES_PASSWORD=change-me-postgres-password

# --- Redis protocol (served by Valkey): BullMQ queues, rate limits, caches ---
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# --- S3-compatible object storage (served by RustFS) ------------------------
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_REGION=us-east-1
S3_BUCKET=openverify-files
S3_ACCESS_KEY_ID=change-me-s3-access-key
S3_SECRET_ACCESS_KEY=change-me-s3-secret-key

# --- Mailpit (development SMTP sink and web UI) -----------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Application secrets (apps/api, packages/db, services/vision) -----------
# Key-encryption key for PII envelope encryption: base64 of 32 random bytes.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
OPENVERIFY_KEK=change-me-base64-of-32-random-bytes
# Retired KEKs still accepted for decryption during rotation (comma-separated, optional).
OPENVERIFY_KEK_PREVIOUS=
# Pepper mixed into API key secret hashes: at least 32 random characters.
OPENVERIFY_API_KEY_PEPPER=change-me-api-key-pepper-at-least-32-chars
# HMAC key of the identification-number blind index (repeat checks): base64 of 32 random bytes,
# a separate secret from OPENVERIFY_KEK. Changing it needs
# `pnpm --filter @openverify/api blind-index:rebuild`, which re-indexes every unredacted row.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
OPENVERIFY_BLIND_INDEX_KEY=change-me-base64-of-32-random-bytes
# Shared secret apps/api sends to services/vision in the x-service-token header (>= 32 chars).
OPENVERIFY_VISION_SERVICE_TOKEN=change-me-vision-service-token-at-least-32-chars

# --- API server and worker (apps/api) ---------------------------------------
# On the host these settings are read as written. In compose (profile app) the containers get
# the same secrets, with service names instead of 127.0.0.1.
OPENVERIFY_MODE=development
OPENVERIFY_LOG_LEVEL=info
OPENVERIFY_API_HOST=127.0.0.1
# Also the API's host port in compose.
OPENVERIFY_API_PORT=3000
# Trust X-Forwarded-* from a reverse proxy in front of the API.
OPENVERIFY_TRUST_PROXY=false
# The passwords in these URLs must equal POSTGRES_PASSWORD and REDIS_PASSWORD above; choose
# URL-safe values (for example hex).
DATABASE_URL=postgres://openverify:change-me-postgres-password@127.0.0.1:5432/openverify
REDIS_URL=redis://:change-me-redis-password@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
# Where end users open the hosted flow; resume links (flow-url) point here.
OPENVERIFY_FLOW_PUBLIC_URL=http://127.0.0.1:5173
# More browser origins allowed to call the flow API, comma-separated. Empty: the flow's own.
OPENVERIFY_FLOW_CORS_ORIGINS=
OPENVERIFY_VISION_URL=http://127.0.0.1:8000
# Jobs each worker queue runs at once (1-64).
OPENVERIFY_WORKER_CONCURRENCY=4
# Let webhooks reach private and loopback addresses. Refused in production mode.
OPENVERIFY_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Server API requests per minute per API key or dashboard session (C12, 1-1000000).
OPENVERIFY_RATE_LIMIT_API_PER_MINUTE=300

# --- Providers of the A-tier government ID checks (C35) ----------------------------------
# The provider each check asks, per environment kind: `sandbox` (deterministic answers chosen by
# documented magic values, docs/checks/sandbox-providers.md) or empty (the check answers
# provider_not_configured). A sandbox provider bound to a _PRODUCTION variable, an unknown name,
# or a real provider without its credentials stops the process that reads the variable (C63): the
# API reads SMS, DATABASE and AAMVA; the worker every kind but SMS.
# id_aamva_database_lookup (AAMVA DLDV):
OPENVERIFY_PROVIDER_AAMVA_SANDBOX=sandbox
OPENVERIFY_PROVIDER_AAMVA_PRODUCTION=
# id_public_figure_detection (a public-figure gallery):
OPENVERIFY_PROVIDER_PUBLIC_FIGURE_SANDBOX=sandbox
OPENVERIFY_PROVIDER_PUBLIC_FIGURE_PRODUCTION=
# id_age_inconsistency_detection (an apparent-age estimator):
OPENVERIFY_PROVIDER_AGE_ESTIMATE_SANDBOX=sandbox
OPENVERIFY_PROVIDER_AGE_ESTIMATE_PRODUCTION=

# --- Providers of the A-tier selfie checks (C44) -------------------------------------------
# The same rules. A provider receives the centre selfie image only. Sandbox providers answer from
# magic tokens in the inquiry's reference-id (docs/checks/sandbox-providers.md).
# selfie_age_comparison (an apparent-age estimator):
OPENVERIFY_PROVIDER_SELFIE_AGE_ESTIMATE_SANDBOX=sandbox
OPENVERIFY_PROVIDER_SELFIE_AGE_ESTIMATE_PRODUCTION=
# selfie_public_figure_detection (a public-figure gallery):
OPENVERIFY_PROVIDER_SELFIE_PUBLIC_FIGURE_SANDBOX=sandbox
OPENVERIFY_PROVIDER_SELFIE_PUBLIC_FIGURE_PRODUCTION=
# selfie_suspicious_entity_detection (a synthetic-face or deepfake detector; unbound, the check
# uses its built-in heuristic):
OPENVERIFY_PROVIDER_SUSPICIOUS_ENTITY_SANDBOX=sandbox
OPENVERIFY_PROVIDER_SUSPICIOUS_ENTITY_PRODUCTION=

# --- Providers of the Phase 5 checks (C55, C57, C59, C63) ----------------------------------
# The same rules. Phone OTP codes (read by the API): `twilio` or `sandbox`. The sandbox sender
# sends nothing and keeps the last codes per environment for POST /api/v1/sandbox/sms-messages/search
# (scope sandbox:read); it is refused for a production environment.
OPENVERIFY_PROVIDER_SMS_SANDBOX=sandbox
OPENVERIFY_PROVIDER_SMS_PRODUCTION=
# The database checks (identity records; read by both processes): `sandbox` only in this version.
OPENVERIFY_PROVIDER_DATABASE_SANDBOX=sandbox
OPENVERIFY_PROVIDER_DATABASE_PRODUCTION=
# Contract wallets (ERC-1271 through an EVM node; read by the worker): `json-rpc` or `sandbox`.
OPENVERIFY_PROVIDER_EVM_RPC_SANDBOX=sandbox
OPENVERIFY_PROVIDER_EVM_RPC_PRODUCTION=
# Twilio's Messaging API, read by the API and the worker (workflow messages) while SMS is bound to
# `twilio`: the account SID (AC + 32 hex), an API key SID (SK + 32 hex) and its secret, and exactly
# one sender: a messaging service SID (MG + 32 hex) or an E.164 number such as +15555550100.
# Placeholders are refused in production mode.
OPENVERIFY_TWILIO_ACCOUNT_SID=
OPENVERIFY_TWILIO_API_KEY_SID=
OPENVERIFY_TWILIO_API_KEY_SECRET=change-me-twilio-api-key-secret-at-least-32-chars
OPENVERIFY_TWILIO_MESSAGING_SERVICE_SID=
OPENVERIFY_TWILIO_FROM=
# The EVM node of each chain, read by the worker only while EVM_RPC is bound to `json-rpc`:
# comma-separated eip155:<chain>=https://... entries (an API key may sit in the path or query,
# never as user:password). http, and private or loopback addresses, only with the flag below,
# for an operator's own node (decision 22).
OPENVERIFY_EVM_RPC_URLS=
OPENVERIFY_EVM_RPC_ALLOW_PRIVATE_NETWORKS=false
# The install ceiling of each environment's otp-sms-max-per-hour setting (C55.7; 1-1000000). An
# environment's own budget defaults to 200 SMS per hour.
OPENVERIFY_OTP_SMS_MAX_PER_HOUR_CEILING=1000
# Device handoff (C96.3; read by the API): the email and SMS handoff links each environment may
# send per hour (1-100000). The budget fails closed: when Valkey cannot answer, nothing is sent.
OPENVERIFY_HANDOFF_SENDS_PER_HOUR=200

# --- Workflows (C143.8; read by the API and the worker) --------------------------------------
# Evaluate Code steps (C123). false turns them off: a step that needs one ends with a step error.
OPENVERIFY_WORKFLOW_CODE_ENABLED=true
# Where Evaluate Code runs for a process on this host: pool (child processes of the worker) or
# socket:<absolute path> (the code-runner service). The pool shares the worker's network, so a
# production worker logs a warning. Compose's app profile always uses the code-runner service.
OPENVERIFY_WORKFLOW_CODE_RUNNER=pool
# The code-runner service (compose's app profile): children at once, and its memory limit. A child
# holds about 100 MB at the 64 MiB guest limit and the server 82 MB, so raise the two together.
OPENVERIFY_CODE_RUNNER_POOL_SIZE=4
OPENVERIFY_CODE_RUNNER_MEMORY=640m
# C263.6 (Workflow 11C): the code runner over the network, the chart's form (compose keeps the
# socket). OPENVERIFY_WORKFLOW_CODE_RUNNER=tcp:<host>:<port> needs the shared token in the worker
# and in the runner (at least 32 bytes; a secret, also read from OPENVERIFY_CODE_RUNNER_TOKEN_FILE),
# and the runner then listens on OPENVERIFY_CODE_RUNNER_LISTEN (<host>:<port>) instead of its socket.
# OPENVERIFY_CODE_RUNNER_TOKEN=change-me-code-runner-token-at-least-32-bytes
# OPENVERIFY_CODE_RUNNER_LISTEN=0.0.0.0:7700
# Local test receivers on loopback, for sandbox environments only. Refused in production.
OPENVERIFY_WORKFLOW_HTTP_ALLOW_LOOPBACK=false
# Comma-separated NAT64 network-specific prefixes, of an RFC 6052 length (/32, /40, /48, /56, /64
# or /96). The embedded IPv4 address of each is checked like 64:ff9b::/96's.
OPENVERIFY_NAT64_PREFIXES=
# Steps of one environment running or enqueued at once (1-10000). An environment's
# workflow-in-flight-cap setting overrides it. Sandbox and production are capped separately.
OPENVERIFY_WORKFLOW_IN_FLIGHT_CAP=50
# Send Slack Message (bound by the worker; the API reads the name alone): `incoming-webhook` (the
# URL is a workflow secret bound to hooks.slack.com) or `sandbox`, which records the message for POST
# /api/v1/sandbox/slack-messages/search and posts nothing; it is refused for a production environment.
OPENVERIFY_PROVIDER_SLACK_SANDBOX=sandbox
OPENVERIFY_PROVIDER_SLACK_PRODUCTION=
# Case attachment scanning (read by the worker; nothing scans before Workflow 8B): `clamd` (a service
# you run; ClamAV is not shipped) or `sandbox`, refused for a production environment. Empty or `none`:
# attachments are not scanned, and the console says so.
OPENVERIFY_PROVIDER_ATTACHMENT_SCANNER_SANDBOX=
OPENVERIFY_PROVIDER_ATTACHMENT_SCANNER_PRODUCTION=
# clamd's Unix socket or private address; required while either kind binds clamd.
OPENVERIFY_CLAMD_SOCKET=

# --- Providers of the KYB checks (C61, C63; read by the worker) ------------------------------
# Business registers: a comma-separated list of gleif, companies-house and sec-edgar; `sandbox`
# alone (sandbox environments only); or `none`. Empty means GLEIF (the open LEI register, no key)
# plus Companies House when its key for the environment kind is set and SEC EDGAR when its
# contact is set. The sandbox register answers by the registration number's last four characters.
OPENVERIFY_PROVIDER_BUSINESS_REGISTRY_SANDBOX=sandbox
OPENVERIFY_PROVIDER_BUSINESS_REGISTRY_PRODUCTION=
# Domain age: `rdap` (registries' RDAP services through the IANA bootstrap), `sandbox` or `none`.
# Empty means rdap.
OPENVERIFY_PROVIDER_DOMAIN_AGE_SANDBOX=sandbox
OPENVERIFY_PROVIDER_DOMAIN_AGE_PRODUCTION=
# Malicious websites: `feed-list` (the feeds you list in data/malicious-feeds.json, which ships
# empty) or `sandbox`. Empty: unbound.
OPENVERIFY_PROVIDER_MALICIOUS_WEBSITE_SANDBOX=sandbox
OPENVERIFY_PROVIDER_MALICIOUS_WEBSITE_PRODUCTION=
# Backlinks: `sandbox` only in this version. Empty: unbound.
OPENVERIFY_PROVIDER_BACKLINK_SANDBOX=sandbox
OPENVERIFY_PROVIDER_BACKLINK_PRODUCTION=
# Companies House API keys (20-64 letters, digits and hyphens): the live service's for production
# environments and the sandbox service's for sandbox environments. Setting a key turns the
# register on for that environment kind; naming companies-house without its key stops the worker.
OPENVERIFY_COMPANIES_HOUSE_API_KEY=
OPENVERIFY_COMPANIES_HOUSE_SANDBOX_API_KEY=
# SEC EDGAR asks every client to identify itself: a User-Agent with your organization's name and
# a contact email address, such as "Example Corp ops@example.com". Setting it turns EDGAR on.
OPENVERIFY_SEC_EDGAR_USER_AGENT=

# --- Government ID NFC trust store (C62.7) -----------------------------------------------------
# Compose passes both to the worker, which acts on them, and to the API, which reports them on the
# console's trust store page (C66).
# The worker's repeatable trust-store refresh (the same sync as trust-anchors:sync). Off: run the
# sync yourself.
OPENVERIFY_TRUST_ANCHOR_REFRESH=false
# Also fetch CRLs from ICAO PKD hosts (national distribution points only by default).
OPENVERIFY_NFC_ALLOW_ICAO_CRLS=false

# --- Reports (Phase 6: C72.5, C76, C80) ------------------------------------------------------
# Per-environment report limits, read by the API and the worker (provisional): report creations
# and run calls per minute (1-1000000), recurring reports (1-10000000), and scheduled adverse-media
# runs per day (1-17280, the whole GDELT install budget; the default is half of it).
OPENVERIFY_RATE_LIMIT_REPORTS_PER_MINUTE=600
OPENVERIFY_REPORTS_MAX_RECURRING_PER_ENVIRONMENT=250000
OPENVERIFY_REPORTS_MAX_MEDIA_RUNS_PER_DAY=8640
# Watchlist sources disabled install-wide: comma-separated ids of watchlists/sources.json, such as
# un-sc. Read the same way by the API, the worker, seed:dev and the watchlist CLIs; a report that
# selects a disabled source errors list_unavailable, it never answers "no match".
OPENVERIFY_WATCHLIST_SOURCES_DISABLED=
# The lists are synced by an operator: `pnpm --filter @openverify/api watchlists:sync` and
# `pep:sync` (in compose: `run --rm worker pnpm --filter @openverify/api watchlists:sync`), or the
# worker's 15-minute refresh tick below. Never in CI. A source not checked within its stale limit
# (48 hours for the sanctions lists, 192 for PEP) makes its reports error list_stale. The settings
# below are read by the worker and the CLIs only.
OPENVERIFY_WATCHLIST_REFRESH=false
# Days a removed list entry is kept before it is purged (1-3650).
OPENVERIFY_WATCHLIST_REMOVED_RETENTION_DAYS=90
# The EU Financial Sanctions Files token (the EU catalogue publishes it). Until it is set the EU
# source stays unconfigured and the reports that select it error list_unavailable. Set it in your
# own .env only; it is never committed.
# OPENVERIFY_EU_FSF_TOKEN=
# Wikidata asks every client to identify itself: a User-Agent with your own contact, such as
# "ExampleScreening/1.0 (ops@example.com)". Until it is set the wikidata-pep source stays
# unconfigured and PEP reports error list_unavailable. The endpoint may be a mirror.
OPENVERIFY_WIKIDATA_USER_AGENT=
OPENVERIFY_WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
# PEP rules (C80): an open-ended tenure counts as current only when it started within this many
# years (1-100); relatives of class 1-2 holders are synced only when true (never minors); holders
# whose every position ended more than these months ago are left out (heads of state or government
# after the second, 1-600).
OPENVERIFY_PEP_OPEN_TENURE_MAX_YEARS=20
OPENVERIFY_PEP_INCLUDE_RELATIVES=false
OPENVERIFY_PEP_RETENTION_MONTHS=12
OPENVERIFY_PEP_HEAD_RETENTION_MONTHS=60

# --- Providers of the reports (C83; read by the worker) --------------------------------------
# The same rules as the check providers above. Unbound, a field that needs the provider is null
# with provider_not_configured, and an adverse-media report errors provider_not_configured.
# Adverse media: `gdelt-doc` (the GDELT DOC 2.0 API) or `sandbox`. GDELT receives every screened
# name, so binding gdelt-doc also needs OPENVERIFY_GDELT_ACKNOWLEDGE_DISCLOSURE=true.
OPENVERIFY_PROVIDER_ADVERSE_MEDIA_SANDBOX=sandbox
OPENVERIFY_PROVIDER_ADVERSE_MEDIA_PRODUCTION=
OPENVERIFY_GDELT_ACKNOWLEDGE_DISCLOSURE=false
# Email breach exposure: `hibp` (Have I Been Pwned, with your own API key on a plan that allows
# screening your users; it treats submitted addresses as subscriber data) or `sandbox`.
OPENVERIFY_PROVIDER_EMAIL_INTELLIGENCE_SANDBOX=sandbox
OPENVERIFY_PROVIDER_EMAIL_INTELLIGENCE_PRODUCTION=
OPENVERIFY_HIBP_API_KEY=
# Phone line type, carrier and SIM swap: `twilio-lookup` (Twilio Lookup v2, with credentials of
# its own, separate from the API's SMS ones; a restricted key is enough) or `sandbox`.
OPENVERIFY_PROVIDER_PHONE_INTELLIGENCE_SANDBOX=sandbox
OPENVERIFY_PROVIDER_PHONE_INTELLIGENCE_PRODUCTION=
OPENVERIFY_TWILIO_LOOKUP_ACCOUNT_SID=
OPENVERIFY_TWILIO_LOOKUP_API_KEY_SID=
OPENVERIFY_TWILIO_LOOKUP_API_KEY_SECRET=change-me-twilio-lookup-api-key-secret
# US postal verification: `smarty` (the US Street API; it receives the address components only,
# and the addressee only when a template sets send-addressee) or `sandbox`.
OPENVERIFY_PROVIDER_ADDRESS_VERIFICATION_SANDBOX=sandbox
OPENVERIFY_PROVIDER_ADDRESS_VERIFICATION_PRODUCTION=
OPENVERIFY_SMARTY_AUTH_ID=
OPENVERIFY_SMARTY_AUTH_TOKEN=change-me-smarty-auth-token
# Crypto exposure analytics on crypto-address-watchlist reports: `sandbox` only in this version.
OPENVERIFY_PROVIDER_CRYPTO_EXPOSURE_SANDBOX=sandbox
OPENVERIFY_PROVIDER_CRYPTO_EXPOSURE_PRODUCTION=

# --- Network data (Phase 7, Workflow 7A: C92, C93; ADR 0006) ----------------------------------
# DB-IP Lite, the Tor exit list and the cloud providers' ranges are synced by the operator only:
# `pnpm --filter @openverify/api network:sync` (in compose: `run --rm worker pnpm --filter
# @openverify/api network:sync`), or the worker's 15-minute refresh tick below. Never in CI, and
# nothing synced is ever committed or shipped. Until a source is synced, the facts it feeds are null
# with list_unavailable, never "clean". Sources of network/sources.json turned off install-wide, and
# the ones it leaves off that you turn on (dbip-city-lite, azure-service-tags, apple-private-relay):
# comma-separated ids, read the same way by the API, the worker, seed:dev and the CLI.
OPENVERIFY_NETWORK_SOURCES_DISABLED=
OPENVERIFY_NETWORK_SOURCES_ENABLED=
# The worker's 15-minute refresh tick (read by the worker only).
OPENVERIFY_NETWORK_REFRESH=false
# IP reputation (the session's is-proxy and the ip-address report's proxy flag), read by the API and
# the worker: `mmdb-file` (an MMDB with anonymous-IP fields that you license yourself; it answers
# locally and sends nothing anywhere) or `sandbox` (the documentation addresses of
# docs/checks/sandbox-providers.md). Unbound, is-proxy is null with provider_not_configured.
OPENVERIFY_PROVIDER_IP_REPUTATION_SANDBOX=sandbox
OPENVERIFY_PROVIDER_IP_REPUTATION_PRODUCTION=
# The mmdb-file adapter's file, as an absolute path; required while either kind binds mmdb-file. In
# compose (profile app) put the file in data/ip-reputation/ and name it
# /var/lib/openverify/ip-reputation/<file>.mmdb, the read-only mount the API and the worker share.
OPENVERIFY_IP_REPUTATION_MMDB_PATH=
# Device integrity (Play Integrity, C211): off by default, so no device is asked for a token. Bind
# `play-integrity` (Google's decodeIntegrityToken with your own service account; Google then
# receives each token, and a flow must show notice.play-integrity) or `sandbox` (the magic tokens
# of docs/checks/sandbox-providers.md; refused in production). Read by the API and the worker.
OPENVERIFY_PROVIDER_DEVICE_INTEGRITY_SANDBOX=
OPENVERIFY_PROVIDER_DEVICE_INTEGRITY_PRODUCTION=
# The sandbox test chip (C208): its face-mismatch scenario needs a directory holding the generated
# fixture face head-turn-b-center.jpg (fixtures/generated/selfie/, made on a development host by
# services/vision/tools/make_synthetic_fixtures.py). Read by the API from its own environment; no
# image holds a face and compose passes none, so leave it unset here: the scenario then answers 422
# sandbox_chip_scenario_unavailable. The end-to-end stack sets it itself.
# OPENVERIFY_SANDBOX_CHIP_FACES=
# The play-integrity decode's settings, read by the worker while either kind binds it: the host
# app's package name, its signing certificate digests (comma-separated, base64url SHA-256 as Play
# Integrity reports them) and your service account's key file as JSON (a secret).
OPENVERIFY_PLAY_INTEGRITY_PACKAGE_NAME=
OPENVERIFY_PLAY_INTEGRITY_CERTIFICATE_DIGESTS=
OPENVERIFY_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=

# --- Operators (C15): dashboard links, BFF client address, WebAuthn, invitation email --------
# Base of invitation links (<url>/accept-invitation#token=...). In production, without it there
# are no invitations.
OPENVERIFY_DASHBOARD_PUBLIC_URL=http://localhost:3001
# Shared secret the dashboard BFF sends (x-openverify-bff-token) so the API trusts the
# operator's address it forwards (x-openverify-client-ip): at least 32 random characters. The API
# and the dashboard read the same value.
OPENVERIFY_DASHBOARD_BFF_TOKEN=change-me-dashboard-bff-token-at-least-32-chars
# Reverse proxies in front of the dashboard that append X-Forwarded-For (0-32). With 0 the
# operator's address is the socket peer the dashboard's server.ts records, and a client-sent
# X-Forwarded-For is never believed. With N it is the Nth X-Forwarded-For entry from the right.
# Behind Docker's port publishing (compose profile app) the socket peer is the bridge gateway, not
# the operator: put a proxy that appends X-Forwarded-For in front and set this to 1.
OPENVERIFY_DASHBOARD_TRUSTED_PROXY_HOPS=0
# WebAuthn relying party: a domain (never an IP address) and the dashboard origin on it.
OPENVERIFY_WEBAUTHN_RP_ID=localhost
OPENVERIFY_WEBAUTHN_RP_NAME=OpenVerify
OPENVERIFY_WEBAUTHN_ORIGIN=http://localhost:3001
# SMTP server for invitation email: Mailpit in development (UI on MAILPIT_UI_PORT). In compose
# (profile app) the API uses smtp://mailpit:1025.
OPENVERIFY_SMTP_URL=smtp://127.0.0.1:1025
OPENVERIFY_MAIL_FROM="OpenVerify <no-reply@localhost>"

# --- Vision service (services/vision) ---------------------------------------
# Provisional thresholds (calibrated in Phases 3 and 4). See services/vision/.env.example.
OPENVERIFY_VISION_BRIGHTNESS_MIN=0.15
OPENVERIFY_VISION_BRIGHTNESS_MAX=0.9
OPENVERIFY_VISION_FACE_SCORE_THRESHOLD=0.9

# --- Hosted flow (apps/flow) and dashboard (apps/dashboard) -----------------
# Baked into the flow bundle at build time: the API as the end user's browser reaches it.
VITE_OPENVERIFY_API_URL=http://127.0.0.1:3000
# C257.1 (Workflow 11C, decision 73): the API's public URL as the flow server reads it at start, for
# a bundle built without VITE_OPENVERIFY_API_URL (the production image); unset, the flow server falls
# back to VITE_OPENVERIFY_API_URL, so compose and the per-push e2e are unchanged.
# OPENVERIFY_FLOW_API_URL=http://127.0.0.1:3000
# C289: on (the default) or off, read when the flow is built; off leaves on-device face guidance
# (onnxruntime-web) out of the bundle.
# OPENVERIFY_FLOW_FACE_GUIDANCE=on
# Server-side only: the API the dashboard calls (in compose: http://api:3000).
OPENVERIFY_API_URL=http://127.0.0.1:3000
# --- Flow server (apps/flow/server.ts; C157, C174.7) --------------------------
# Shared secret the flow server sends on the API's internal embed-policy lookup (C157.2): at
# least 32 random bytes, for example 64 hex characters. The API and the flow server read the same
# value; checked at startup. Without it the API accepts no lookup, so nothing can embed the flow.
OPENVERIFY_FLOW_SERVER_TOKEN=change-me-flow-server-token-at-least-32-bytes
# During a rotation only: the previous token, still accepted by the API until every flow server
# sends the new one. Leave it commented out otherwise.
# OPENVERIFY_FLOW_SERVER_TOKEN_PREVIOUS=
# The API as the flow server reaches it (in compose: http://api:3000).
OPENVERIFY_FLOW_SERVER_API_URL=http://127.0.0.1:3000
# Reverse proxies in front of the flow server that append X-Forwarded-For (0-32), for its
# per-client limit on /embed/*; with 0 a client-sent X-Forwarded-For is never believed.
OPENVERIFY_FLOW_SERVER_TRUSTED_PROXY_HOPS=0
# The console's script policy (C170.2): enforce (default) or report-only.
OPENVERIFY_DASHBOARD_CSP_MODE=enforce
# Host ports of the flow and dashboard containers (compose profile app).
OPENVERIFY_FLOW_PORT=5173
OPENVERIFY_DASHBOARD_PORT=3001
# The dashboard's session cookie is Secure in production builds. Set true only to serve the
# dashboard over plain HTTP on an address other than localhost (a LAN test box); never in production.
OPENVERIFY_DASHBOARD_INSECURE_COOKIES=false

# --- Dev seed (pnpm --filter @openverify/api seed:dev [--mfa-admin]) -------
# One dashboard operator per built-in role (passwords: at least 12 characters). The seed also
# creates the sandbox and production environments and prints a new sandbox API key holding
# every scope, once.
OPENVERIFY_SEED_ADMIN_EMAIL=admin@example.test
OPENVERIFY_SEED_ADMIN_PASSWORD=change-me-admin-password
OPENVERIFY_SEED_DEVELOPER_EMAIL=developer@example.test
OPENVERIFY_SEED_DEVELOPER_PASSWORD=change-me-developer-password
OPENVERIFY_SEED_REVIEWER_EMAIL=reviewer@example.test
OPENVERIFY_SEED_REVIEWER_PASSWORD=change-me-reviewer-password
OPENVERIFY_SEED_VIEWER_EMAIL=viewer@example.test
OPENVERIFY_SEED_VIEWER_PASSWORD=change-me-viewer-password
# With --mfa-admin only: a second admin enrolled in TOTP. The seed prints its secret once
# (replacing the previous factor on every run); it is sealed with OPENVERIFY_KEK.
OPENVERIFY_SEED_MFA_ADMIN_EMAIL=mfa-admin@example.test
OPENVERIFY_SEED_MFA_ADMIN_PASSWORD=change-me-mfa-admin-password
# Name of the organization the seed creates. Empty: OpenVerify Dev.
OPENVERIFY_SEED_ORGANIZATION_NAME=

# Connect (Phase 11, Workflow 11A; C231.10, decision 71): sharing a verified person's data between
# organisations of this install. Off unless set: the images and the chart default to false. A
# development install turns it on; each organisation still opts in to inbound connections with its
# own connect-inbound setting.
OPENVERIFY_CONNECT_ENABLED=true

# --- Platform hardening (Phase 11, Workflow 11B) ---------------------------------------------
# Console sessions (C245.1; read by the API): a session ends after this many seconds without an
# authenticated request (300-86400; 30 minutes is provisional), and after the absolute limit in all
# (3600-86400, at least the idle limit).
OPENVERIFY_CONSOLE_IDLE_TIMEOUT_SECONDS=1800
OPENVERIFY_CONSOLE_ABSOLUTE_TIMEOUT_SECONDS=43200
# API-key pepper rotation (C247.1; read by the API and the worker): up to two earlier peppers,
# comma-separated, while keys made under them are re-hashed on use. Empty: no rotation under way.
OPENVERIFY_API_KEY_PEPPER_PREVIOUS=
# SSO (C248.3; read by the API): OIDC issuer URLs the outbound guard may reach on a private address
# in production, comma-separated (at most 20). Outside production private addresses are allowed.
OPENVERIFY_SSO_PRIVATE_ISSUERS=
# TLS to the data stores (C249.1): absolute paths of the CAs that sign each store's certificate,
# for sslmode=verify-full, rediss://, an https S3 endpoint and an https vision URL. Empty: the
# system's CAs (and, in production, one warning per store whose transport is not verified).
OPENVERIFY_POSTGRES_CA_FILE=
OPENVERIFY_REDIS_CA_FILE=
OPENVERIFY_S3_CA_FILE=
OPENVERIFY_VISION_CA_FILE=
# The migration role (C249.3; read by db:migrate): set OPENVERIFY_MIGRATION_DATABASE_URL to the
# role that owns the schema and keep DATABASE_URL for the runtime role. Unset here: db:migrate uses
# DATABASE_URL (with a warning in production). The migrate lock waits this many seconds (1-3600),
# then exits 75 (C249.4).
OPENVERIFY_MIGRATE_LOCK_TIMEOUT_SECONDS=600
# The worker's heartbeat file for an exec probe (C250.2).
OPENVERIFY_WORKER_HEARTBEAT_FILE=/tmp/openverify-worker-heartbeat
# host:port of a second listener for /api/v1/internal/* (C250.3). Empty: those routes stay on the
# public listener, behind the flow server's token.
OPENVERIFY_INTERNAL_LISTEN=
# The install ceiling of every per-environment queue cap (C251.2; 1-1000, provisional).
OPENVERIFY_QUEUE_IN_FLIGHT_CAP_MAX=50
# The UN Security Council list's opt-in (C254.1, Q10 granted): true lets an environment admin enable
# un-sc for that environment with an audited acknowledgement of the UN's terms and a step-up; no
# environment is opted in by default. false locks the list on this install.
OPENVERIFY_WATCHLIST_UN_OPT_IN_ALLOWED=true
# Strict-Transport-Security max-age for installs whose TLS terminator cannot send it (C255.1; read
# by the API, the flow server and the console). 0 sends no header.
OPENVERIFY_HSTS_MAX_AGE=0
