{
  "$schema": "./review-status.schema.json",
  "format": 1,
  "description": "C199.1, C161.5 (review H14): the review status of each SDK locale, in the form of Phase 9's LOCALE_REVIEW_STATUS (source, machine-drafted, partially-reviewed, reviewed {by, date, catalogSha256}); a reviewed record also keeps keySha256, the SHA-256 of each NFC text as reviewed, so a key whose text changed downgrades the locale to partially-reviewed (android-i18n's test). keys lists every SDK string with the file that defines it: an agent that adds strings adds their keys here (a named borrowed edit, rule 20). Every non-English SDK catalog is machine-drafted: no translation is called reviewed without a record.",
  "locales": {
    "en": {
      "status": "source"
    },
    "es": {
      "status": "machine-drafted"
    },
    "fr": {
      "status": "machine-drafted"
    },
    "de": {
      "status": "machine-drafted"
    },
    "ar": {
      "status": "machine-drafted"
    }
  },
