# openverify-vision configuration. Copy to .env (never commit .env) and replace the placeholders.

# Shared secret that apps/api sends in the x-service-token header. At least 32 characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
OPENVERIFY_VISION_SERVICE_TOKEN=replace-with-a-random-value-of-at-least-32-chars

# Upload and decode limits.
OPENVERIFY_VISION_MAX_UPLOAD_BYTES=10485760
OPENVERIFY_VISION_MAX_IMAGE_PIXELS=40000000

# Where scripts/fetch_models.py puts model weights (/models inside the container).
OPENVERIFY_VISION_MODELS_DIR=../../models

# Provisional quality thresholds (calibrated in Phase 3).
OPENVERIFY_VISION_BLUR_THRESHOLD=100.0
OPENVERIFY_VISION_GLARE_THRESHOLD=0.05

# Exposure flags in the C6 quality object: mean brightness (0-1) below MIN is too dark,
# above MAX is too bright.
OPENVERIFY_VISION_BRIGHTNESS_MIN=0.15
OPENVERIFY_VISION_BRIGHTNESS_MAX=0.9

# Minimum YuNet confidence for a detection to count as a face.
OPENVERIFY_VISION_FACE_SCORE_THRESHOLD=0.9
