{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenVerify chart values",
  "description": "C263.2 (Workflow 11C Stage 1a, contracts-11c; frozen, an 11C shared file). Generated by code, never typed by hand. Relational rules JSON Schema cannot hold (migrate.activeDeadlineSeconds above lockTimeoutSeconds, the pools within maxConnections) are the templates' fail calls.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^(sha256:[0-9a-f]{64})?$",
      "description": "An image digest, sha256:<64 hex>, preferred over the tag; empty uses the tag."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/definitions/digest"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository"]
    },
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}|[0-9a-fA-F:]+/[0-9]{1,3})$"
    },
    "egressRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cidr": {
          "$ref": "#/definitions/cidr"
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      },
      "required": ["cidr", "ports"]
    },
    "egressList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/egressRule"
      }
    },
    "caSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMap": {
          "type": "string",
          "minLength": 1
        },
        "secret": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "maxProperties": 0
        },
        {
          "required": ["configMap"],
          "not": {
            "required": ["secret"]
          }
        },
        {
          "required": ["secret"],
          "not": {
            "required": ["configMap"]
          }
        }
      ],
      "description": "A CA bundle for a store's *_CA_FILE (C249.1): {configMap} or {secret}, with its key; empty: none."
    },
    "secretBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      },
      "required": ["existingSecret", "keys"]
    },
    "envList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          }
        },
        "required": ["name", "value"]
      }
    },
    "selectorBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podSelector": {
          "type": "object"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": ["podSelector", "port"]
    }
  },
  "properties": {
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name"]
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["production", "development"]
        },
        "connectEnabled": {
          "type": "boolean"
        },
        "watchlistUnOptInAllowed": {
          "type": "boolean"
        },
        "queueInFlightCapMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "hstsMaxAge": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63072000
        },
        "logLevel": {
          "enum": ["fatal", "error", "warn", "info", "debug", "trace", "silent"]
        }
      },
      "required": [
        "mode",
        "connectEnabled",
        "watchlistUnOptInAllowed",
        "queueInFlightCapMax",
        "hstsMaxAge"
      ]
    },
    "publicUrls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "type": "string",
          "pattern": "^(https?://[^\\s?#]+)?$"
        },
        "flow": {
          "type": "string",
          "pattern": "^(https?://[^\\s?#]+)?$"
        },
        "dashboard": {
          "type": "string",
          "pattern": "^(https?://[^\\s?#]+)?$"
        }
      }
    },
    "external": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "migrationSecret": {
              "type": "string"
            },
            "migrationKey": {
              "type": "string",
              "minLength": 1
            },
            "runtimeRole": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,62}$"
            },
            "maxConnections": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "ca": {
              "$ref": "#/definitions/caSource"
            }
          }
        },
        "valkey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "ca": {
              "$ref": "#/definitions/caSource"
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "bucket": {
              "type": "string"
            },
            "forcePathStyle": {
              "type": "boolean"
            },
            "existingSecret": {
              "type": "string"
            },
            "ca": {
              "$ref": "#/definitions/caSource"
            }
          }
        },
        "smtp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "mailFrom": {
              "type": "string"
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "$ref": "#/definitions/secretBlock"
        },
        "worker": {
          "$ref": "#/definitions/secretBlock"
        },
        "migrate": {
          "$ref": "#/definitions/secretBlock"
        },
        "dashboard": {
          "$ref": "#/definitions/secretBlock"
        },
        "flow": {
          "$ref": "#/definitions/secretBlock"
        },
        "codeRunner": {
          "$ref": "#/definitions/secretBlock"
        },
        "vision": {
          "$ref": "#/definitions/secretBlock"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "hosts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "api": {
              "type": "string"
            },
            "flow": {
              "type": "string"
            },
            "dashboard": {
              "type": "string"
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string",
                "minLength": 1
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": ["secretName", "hosts"]
          }
        },
        "hsts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxAge": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63072000
            },
            "includeSubDomains": {
              "type": "boolean"
            },
            "preload": {
              "type": "boolean"
            }
          }
        },
        "maxBodySize": {
          "type": "string",
          "pattern": "^[0-9]+[kmg]$"
        },
        "maxBodySizeImport": {
          "type": "string",
          "pattern": "^[0-9]+[kmg]$"
        },
        "maxBodySizeTransactionFile": {
          "type": "string",
          "pattern": "^[0-9]+[kmg]$"
        },
        "annotations": {
